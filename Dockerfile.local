# syntax=docker/dockerfile:1
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS frontend-tests
WORKDIR /work/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
COPY docs/ /work/docs/
CMD ["sh", "-c", "npm run lint && npm test && npm run build"]

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS backend-tests
WORKDIR /work/backend
COPY backend/ ./
COPY docs/ /work/docs/
RUN pip install --no-cache-dir '.[dev]'
ENV SYNC_ENABLED=false UPDATE_CHECK_ENABLED=false
CMD ["sh", "-c", "python -m pytest -q && ruff check app tests"]

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS browser-tests
WORKDIR /browser
RUN apk add --no-cache chromium
RUN npm init -y && npm install --save-exact playwright@1.56.1
COPY tests/browser.mjs ./browser.mjs
CMD ["node", "browser.mjs"]
