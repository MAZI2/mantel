# ---------------------------------------------------------------------------
# Mantel. Copy to .env and edit:  cp .env.example .env
#
# Set up the certificate-proxy handoff below before deploying this fork.
# Google, iCloud, themes and other profile preferences are configured in Settings.
# See docs/profiles.md for the deployment contract and existing-data preservation.
# ---------------------------------------------------------------------------

# Port the app is served on.
PORT=8080

# Encrypts stored Google tokens, your Google client secret and every iCloud
# app-specific password, and signs the OAuth handshake. Generate your own --
# any random string works, it is hashed into a key:
#   openssl rand -base64 32
#
# Keep it. Changing it means every family member reconnects their account once,
# and your calendar subscription links change.
SECRET_KEY=dev-insecure-change-me


# Trusted certificate proxy. Use the same server-only random secret in Nginx.
# The stable person ID must match the proxy's X-Mantel-Identity, not a fingerprint.
# Bootstrap is used only for the first administrator; later roles live in Mantel.
MANTEL_AUTH_MODE=proxy
MANTEL_PROXY_SECRET=
MANTEL_BOOTSTRAP_ADMIN_IDENTITY=
PUBLIC_BASE_URL=https://calendar.mpog.dev

# ---------------------------------------------------------------------------
# Everything below is optional and has a sensible default. Most people can
# delete this whole section.
# ---------------------------------------------------------------------------

# SQLite is right for a family: it runs in WAL mode, so every screen can read
# while somebody is editing. New profiles and the access registry use separate
# SQLite files alongside this existing personal database. Back up the whole /data volume.
DATABASE_URL=sqlite:////data/family.db

# How often to pull changes from Google and iCloud, and how often to retry a
# failed push.
SYNC_INTERVAL_SECONDS=300
PUSH_INTERVAL_SECONDS=15

# How far back to import events the first time a calendar syncs, in days.
SYNC_PAST_DAYS=90

# Set to false to pause all syncing, Google and iCloud alike, without
# unlinking anyone.
SYNC_ENABLED=true

# Used only in explicit local authentication mode. Proxy mode is same-origin.
CORS_ORIGINS=*

# --- Google Calendar: configure this in Settings → Google, not here ---------
# iCloud needs nothing here at all -- no client id, no secret, no redirect URI.
# Each person adds an app-specific password under Settings → Apple.
# These are read once on first start and copied into the app's own settings,
# so an installation that predates the Settings screen keeps working. New
# installs should leave them empty and use Settings → Google, which walks you
# through creating them and shows the exact redirect URI to give Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
